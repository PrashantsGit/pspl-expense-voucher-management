# ============================================================================
# Environment Configuration Template - Expense Voucher Management System
# Copy this file to .env or export these variables in your deployment environment.
# ============================================================================

# Database Configuration (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/prachay_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_mysql_username
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# Server Port
SERVER_PORT=8080

# File Upload Directory (Private local disk storage)
APP_UPLOAD_DIR=uploads/signatures

# Demo Data Initialization (Set to false or run with 'prod' profile in production)
APP_SEED_DEMO_DATA=true

# JWT Authentication
# Replace with a cryptographically secure random key (at least 256-bit / 32-byte Base64 or string)
# e.g., generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_random_256_bit_or_stronger_secret
JWT_EXPIRATION_MS=86400000

# Frontend Configuration
VITE_API_BASE_URL=/api
